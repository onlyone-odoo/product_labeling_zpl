<odoo>
    <record id="view_product_label_layout_form_inherit" model="ir.ui.view">
        <field name="name">product.label.layout.form.inherit</field>
        <field name="model">product.label.layout</field>
        <field name="inherit_id" ref="stock.product_label_layout_form_picking"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="label_type"/>
                <field name="batch_id" domain="[('product_id', '=', product_id)]" invisible="[('product_id', '=', False)]"/>
                <field name="quantity"/>
            </field>
        </field>
    </record>
</odoo>