<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_label_layout_view_form_inherit" model="ir.ui.view">
        <field name="name">product.label.layout.form.inherit</field>
        <field name="model">product.label.layout</field>
        <field name="inherit_id" ref="product.product_label_layout_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='print_format']" position="after">
                <field name="lot_name" readonly="1"/>
                <field name="manufacturing_date" readonly="1"/>
                <field name="expiration_date" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>